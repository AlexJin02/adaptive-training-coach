# Application
APP_NAME=Adaptive Training Coach
API_PREFIX=/api/v1
ATHLETE_TIMEZONE=Europe/London

# The backend is started from ./backend, so this resolves to
# backend/data/training_coach.db.
DATABASE_URL=sqlite:///./data/training_coach.db

# Browser client
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'

# Optional OpenAI features. Leave blank to run in deterministic/offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_PLANNER_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional Strava running sync. A current access token works on its own. For automatic token
# refresh, configure client ID, client secret and refresh token instead (or alongside it).
STRAVA_ACCESS_TOKEN=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Privacy defaults: extracted screenshots and transcribed audio are removed
# after a successful, user-confirmed workflow.
RETAIN_RAW_SCREENSHOTS=false
RETAIN_RAW_AUDIO=false

# Demo data is explicit and removable; it is never loaded silently.
LOAD_DEMO_DATA=false
